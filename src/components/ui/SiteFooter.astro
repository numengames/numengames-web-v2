---
import pkg from '../../../package.json';
import BrandMark from './BrandMark.astro';
import PixelArt from '../narrative/PixelArt.astro';
import BinarySeparator from '../narrative/BinarySeparator.astro';
import { localePath, useTranslations, type Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container-n">
    <BinarySeparator />
    <p class="motto">{t('footer.motto')}</p>

    <div class="cols">
      <nav aria-label={t('footer.legal')}>
        <ul>
          <li><a href={localePath(lang, 'accesibilidad')}>Accesibilidad · Accessibility</a></li>
          <li><a href={localePath(lang, 'privacidad')}>Privacidad · Privacy</a></li>
          <li><a href={localePath(lang, 'terminos')}>Términos · Terms</a></li>
          <li><a href={localePath(lang, 'cookies')}>Cookies</a></li>
        </ul>
      </nav>

      <journey-reset data-done={t('journey.resetDone')}>
        <button type="button" class="btn btn-quiet">{t('journey.reset')}</button>
      </journey-reset>
    </div>

    <p class="fine">
      © {year}
      {t('site.name')} · {t('footer.version')}
      <span class="ver">v{pkg.version}</span>
    </p>
    <div class="cierre">
      <BrandMark name="khepri" class="khepri-close" label="Khepri" />
      <span id="numinia-sigil" class="sigil rarity-legendario">
        <PixelArt name="khepri-px" class="sigil-px" />
        <BrandMark name="numinia" class="sigil-word" label="Numinia" />
        <span class="sigil-line">{t('footer.sigil')}</span>
      </span>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--section-pad);
    border-top: 1px solid var(--line);
    /* s700 / s900: el hueco inferior deja aire a la carta de travesía. */
    padding-block: var(--space-700) var(--space-900);
    background: var(--surface-sunken);
  }
  .motto {
    font-family: var(--stack-serif);
    font-style: italic;
    font-size: var(--text-lg);
    color: var(--ink-muted);
  }
  .cols {
    margin-top: var(--space-500);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-400);
  }
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-400);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  a {
    font-size: var(--text-sm);
    color: var(--ink-muted);
  }
  a:hover {
    color: var(--ink);
  }
  /* Texto corrido en caja baja: sin tracking (el +0.10em es solo para
     etiquetas versales, §4.3; el 0.08em era un valor inventado). */
  .fine {
    margin-top: var(--space-500);
    font-size: var(--text-xs);
    color: var(--ink-muted);
  }
  /* Cifra → Mono tabular (§4.4). */
  .ver {
    font-family: var(--stack-mono);
    font-variant-numeric: tabular-nums;
    color: var(--accent);
  }
  .cierre {
    margin-top: var(--space-600);
    display: flex;
    align-items: center;
    gap: var(--space-500);
    flex-wrap: wrap;
  }
  .cierre :global(.khepri-close) {
    width: 30px;
    color: var(--ink);
  }
  .sigil {
    align-items: center;
    gap: var(--space-300);
    padding: var(--space-200) var(--space-300);
    border: 1px solid;
    border-radius: var(--radius-ctrl);
    font-family: var(--stack-mono);
    font-weight: 500;
    font-size: var(--text-etiqueta);
    letter-spacing: 0.1em;
  }
  .sigil.is-found {
    display: inline-flex;
  }
  /* La marca píxel va en tinta, no en Ámbar (§8.3: no recolorear a
     acentos), y a escala entera de su rejilla de 32 (§2.4). */
  .sigil :global(.sigil-px) {
    width: 32px;
    color: var(--ink);
  }
  .sigil :global(.sigil-word) {
    width: 96px;
    color: var(--ink);
  }
</style>
