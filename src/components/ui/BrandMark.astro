---
/** Activos canónicos de marca (§8): siempre currentColor, nunca recolorear. */
import horizontal from '../../../public/brand/Numen_Games_Horizontal_Word.svg?raw';
import vertical from '../../../public/brand/Numen_Games_Vertical_Word.svg?raw';
import ng from '../../../public/brand/NG_Logo.svg?raw';
import khepri from '../../../public/brand/Khepri_Logo.svg?raw';
import numinia from '../../../public/brand/Numinia_Word.svg?raw';

const marks = { horizontal, vertical, ng, khepri, numinia } as const;

interface Props {
  name: keyof typeof marks;
  class?: string;
  label?: string;
}
const { name, class: className, label } = Astro.props;
---

<span
  class:list={['brand-mark', className]}
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  set:html={marks[name]}
/>

<style>
  .brand-mark {
    display: inline-flex;
    color: var(--ink);
  }
  .brand-mark :global(svg) {
    width: 100%;
    height: auto;
    display: block;
  }
</style>
