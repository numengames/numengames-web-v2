---
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import { localePath, type Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
  entry: CollectionEntry<'story'>;
}
const { lang, entry } = Astro.props;
const { Content } = await render(entry);
const href = localePath(lang, entry.data.portalKey ?? 'experiencias', entry.data.portalHash ?? '');
---

<a class="portal" href={href} data-reveal>
  <div>
    <h3>{entry.data.title}</h3>
    <div class="portal-body"><Content /></div>
  </div>
  <span class="go" aria-hidden="true">→</span>
</a>

<style>
  .portal-body {
    margin-top: var(--space-300);
  }
  /* Cuerpo de tarjeta §9.4: cuerpo.s en texto secundario. */
  .portal-body :global(p) {
    color: var(--ink-muted);
    font-size: var(--text-sm);
  }
</style>
