---
/** Sprites del Khepri Kit convertidos a SVG (scripts/pixel-svg.mjs). */
import portal from '../../assets/pixel/portal.svg?raw';
import nomada from '../../assets/pixel/nomada.svg?raw';
import senet from '../../assets/pixel/senet.svg?raw';
import quest from '../../assets/pixel/quest.svg?raw';
import dado from '../../assets/pixel/dado.svg?raw';
import moneda from '../../assets/pixel/moneda.svg?raw';
import sello from '../../assets/pixel/sello.svg?raw';
import khepriPx from '../../assets/pixel/khepri-px.svg?raw';

const art = { portal, nomada, senet, quest, dado, moneda, sello, 'khepri-px': khepriPx } as const;

interface Props {
  name: keyof typeof art;
  class?: string;
}
const { name, class: className } = Astro.props;
---

<span class:list={['pixel-art', className]} set:html={art[name]} />

<style>
  .pixel-art {
    display: inline-flex;
  }
  .pixel-art :global(svg) {
    width: 100%;
    height: auto;
    display: block;
  }
</style>
