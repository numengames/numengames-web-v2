---
/**
 * Personajes pixelados originales (rejilla 20×24).
 * — Senet: director de juego; báculo y banda de tablero (guiño al senet).
 * — El Nómada: avatar del jugador; capucha, hatillo y dos frames de paso.
 */
interface Props {
  name: 'senet' | 'nomada';
  class?: string;
}
const { name, class: className } = Astro.props;
---

{
  name === 'senet' && (
    <svg
      class:list={['character', className]}
      viewBox="0 0 20 24"
      shape-rendering="crispEdges"
      aria-hidden="true"
    >
      <g fill="currentColor">
        <rect x="6" y="0" width="8" height="2" />
        <rect x="4" y="2" width="2" height="6" />
        <rect x="14" y="2" width="2" height="6" />
        <rect x="5" y="7" width="10" height="2" />
        <rect x="4" y="9" width="12" height="3" />
        <rect x="3" y="13" width="14" height="9" />
        <rect x="2" y="22" width="16" height="2" />
      </g>
      <rect x="6" y="2" width="8" height="5" fill="var(--surface-sunken)" />
      <g fill="var(--accent)">
        <rect x="8" y="4" width="1" height="1" />
        <rect x="11" y="4" width="1" height="1" />
        <rect x="5" y="12" width="1" height="1" />
        <rect x="7" y="12" width="1" height="1" />
        <rect x="9" y="12" width="1" height="1" />
        <rect x="11" y="12" width="1" height="1" />
        <rect x="13" y="12" width="1" height="1" />
      </g>
      <g fill="currentColor">
        <rect x="17" y="5" width="1" height="19" />
      </g>
      <g fill="var(--accent)">
        <rect x="16" y="2" width="3" height="3" />
      </g>
    </svg>
  )
}
{
  name === 'nomada' && (
    <svg
      class:list={['character', 'nomada', className]}
      viewBox="0 0 20 24"
      shape-rendering="crispEdges"
      aria-hidden="true"
    >
      <g fill="currentColor">
        <rect x="7" y="1" width="7" height="2" />
        <rect x="6" y="3" width="2" height="4" />
        <rect x="8" y="3" width="7" height="2" />
        <rect x="6" y="7" width="11" height="3" />
        <rect x="5" y="10" width="12" height="8" />
      </g>
      <rect x="12" y="5" width="3" height="2" fill="var(--surface-sunken)" />
      <rect x="13" y="5" width="1" height="1" fill="var(--accent)" />
      <g fill="currentColor">
        <rect x="14" y="4" width="1" height="1" />
        <rect x="15" y="3" width="1" height="1" />
        <rect x="16" y="2" width="1" height="1" />
      </g>
      <rect x="16" y="0" width="3" height="3" fill="var(--accent)" />
      <rect x="3" y="11" width="3" height="5" fill="var(--accent)" />
      <g class="f-a" fill="currentColor">
        <rect x="6" y="18" width="3" height="6" />
        <rect x="12" y="18" width="3" height="6" />
      </g>
      <g class="f-b" fill="currentColor">
        <rect x="4" y="19" width="3" height="5" />
        <rect x="14" y="19" width="3" height="5" />
      </g>
    </svg>
  )
}

<style>
  svg {
    display: block;
  }
</style>
