---
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import { useTranslations, type Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
  entry: CollectionEntry<'story'>;
  slug: string;
}
const { lang, entry, slug } = Astro.props;
const t = useTranslations(lang);
const { Content } = await render(entry);
const choice = entry.data.choice;
---

<article class="camino" data-reveal aria-labelledby={`${slug}-title`}>
  <h3 class="camino-title" id={`${slug}-title`}>{entry.data.title}</h3>
  <div class="camino-body">
    <Content />
  </div>

  {
    choice && (
      <journey-choice data-id={`choice-${slug}`} data-announce={t('a11y.choiceMade')}>
        <p class="choice-q">{choice.question}</p>
        <div class="choice-opts" role="group" aria-label={choice.question}>
          {choice.options.map((opt, i) => (
            <button type="button" class="btn" data-option={i}>
              {opt.label}
            </button>
          ))}
        </div>
        {choice.options.map((opt, i) => (
          <div class="choice-outcome" data-outcome={i}>
            <p class="outcome-label">
              {t('choice.if')} «{opt.label}»
            </p>
            <p>{opt.outcome}</p>
          </div>
        ))}
      </journey-choice>
    )
  }
</article>

<style>
  .camino-title {
    font-family: var(--stack-display);
    font-stretch: 118%;
    font-weight: 700;
    font-size: var(--text-xl);
  }
  .camino-body {
    margin-top: 0.9rem;
    display: grid;
    gap: 0.9rem;
  }
  .camino-body :global(p) {
    max-width: var(--measure);
  }
  .camino-body :global(.beat) {
    font-family: var(--stack-serif);
    font-size: var(--text-lg);
  }
  journey-choice {
    display: block;
    margin-top: 1.2rem;
  }
</style>
