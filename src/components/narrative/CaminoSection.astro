---
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import PixelArt from './PixelArt.astro';
import { useTranslations, type Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
  entry: CollectionEntry<'story'>;
  slug: string;
  actLabel: string;
}
const { lang, entry, slug, actLabel } = Astro.props;
const t = useTranslations(lang);
const { Content } = await render(entry);
const headingId = `${slug}-title`;
const choice = entry.data.choice;
---

<section class="phase panel camino-panel" aria-labelledby={headingId}>
  <div class="container-n">
    <p class="eyebrow" data-reveal>{actLabel}</p>
    <h2 class="phase-title quest-title" id={headingId} data-reveal>
      <span class="quest-mark" aria-hidden="true"><PixelArt name="quest" /></span>
      {entry.data.title}
    </h2>

    <div class="dialog px" data-reveal>
      <p class="speaker">
        <span class="speaker-portrait"><PixelArt name="senet" /></span>
        <span>{t('speaker.senet')}</span>
      </p>
      <type-writer class="prose-n" data-skip-label={t('tw.skip')}>
        <Content />
      </type-writer>

      {
        choice && (
          <journey-choice data-id={`choice-${slug}`} data-announce={t('a11y.choiceMade')}>
            <p class="choice-q">
              <span class="dado-mark" aria-hidden="true">
                <PixelArt name="dado" />
              </span>
              {choice.question}
            </p>
            <div class="choice-opts" role="group" aria-label={choice.question}>
              {choice.options.map((opt, i) => (
                <button type="button" class="btn" data-option={i}>
                  {opt.label}
                </button>
              ))}
            </div>
            {choice.options.map((opt, i) => (
              <div class="choice-outcome" data-outcome={i}>
                <p class="outcome-label">
                  {t('choice.if')} «{opt.label}»
                </p>
                <p>{opt.outcome}</p>
              </div>
            ))}
          </journey-choice>
        )
      }
    </div>
  </div>
</section>

<style>
  .quest-title {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .quest-title :global(.pixel-art) {
    width: 1.15em;
    color: var(--ink-muted);
  }
  .choice-q {
    display: flex;
    align-items: center;
    gap: 0.55rem;
  }
  .dado-mark :global(svg) {
    width: 1.4em;
  }
  .dado-mark {
    color: var(--ink-muted);
  }
</style>
