---
import PixelArt from './PixelArt.astro';
import { useTranslations, type Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

const acts = [
  {
    n: 'I',
    anchor: '#acto-1',
    phases: 'fase-0,fase-1',
    rarity: 'poco-comun',
    item: t('item.1'),
    rname: t('rarity.pocoComun'),
  },
  {
    n: 'II',
    anchor: '#acto-2',
    phases: 'fase-2,fase-3',
    rarity: 'raro',
    item: t('item.2'),
    rname: t('rarity.raro'),
  },
  {
    n: 'III',
    anchor: '#acto-3',
    phases: 'fase-4,fase-5,fase-6',
    rarity: 'epico',
    item: t('item.3'),
    rname: t('rarity.epico'),
  },
];
---

<journey-progress class="journey-meter" style="--journey-progress: 0">
  <div
    class="journey-track"
    role="progressbar"
    aria-label={t('journey.label')}
    aria-valuemin="0"
    aria-valuemax="100"
    aria-valuenow="0"
  >
    <div class="journey-fill"></div>
  </div>

  <p class="hud-score">
    <span class="hud-token" aria-hidden="true"><PixelArt name="token" /></span>
    <span class="visually-hidden">{t('hud.scoreLabel')}: </span><b data-score>000</b><span
      aria-hidden="true">/</span
    ><span class="visually-hidden"> / </span><span data-max>000</span>
  </p>

  <nav class="journey-acts" aria-label={t('journey.slots')}>
    {
      acts.map((a) => (
        <a
          class="journey-act"
          href={a.anchor}
          data-phases={a.phases}
          data-rarity={a.rarity}
          aria-label={`${t('journey.goto')} ${a.n} · ${a.item} (${a.rname})`}
        >
          <span class="slot-n" aria-hidden="true">
            {a.n}
          </span>
          <span class="slot-item">
            <PixelArt name="sello" />
          </span>
        </a>
      ))
    }
  </nav>
</journey-progress>
