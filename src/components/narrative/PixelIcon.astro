---
/**
 * Sprites originales de la aventura (rejilla 16×16, sin IP de terceros).
 * currentColor = tinta; var(--accent) = oro.
 */
interface Props {
  name: 'grieta' | 'portal' | 'brujula' | 'puertas' | 'pergamino' | 'salida';
}
const { name } = Astro.props;
---

{
  name === 'grieta' && (
    <svg viewBox="0 0 16 16" shape-rendering="crispEdges" aria-hidden="true">
      <g fill="currentColor">
        <rect x="7" y="0" width="2" height="3" />
        <rect x="6" y="3" width="2" height="2" />
        <rect x="8" y="5" width="2" height="3" />
        <rect x="9" y="4" width="2" height="1" />
        <rect x="7" y="8" width="2" height="2" />
        <rect x="4" y="9" width="3" height="1" />
        <rect x="5" y="10" width="2" height="3" />
        <rect x="7" y="13" width="2" height="3" />
      </g>
      <rect x="10" y="7" width="1" height="1" fill="var(--accent)" />
    </svg>
  )
}
{
  name === 'portal' && (
    <svg viewBox="0 0 16 16" shape-rendering="crispEdges" aria-hidden="true">
      <g fill="currentColor">
        <rect x="3" y="4" width="2" height="9" />
        <rect x="11" y="4" width="2" height="9" />
        <rect x="4" y="2" width="2" height="2" />
        <rect x="10" y="2" width="2" height="2" />
        <rect x="6" y="1" width="4" height="2" />
        <rect x="3" y="13" width="10" height="2" />
      </g>
      <g fill="var(--accent)">
        <rect x="7" y="5" width="2" height="7" />
        <rect x="5" y="7" width="6" height="2" />
      </g>
    </svg>
  )
}
{
  name === 'brujula' && (
    <svg viewBox="0 0 16 16" shape-rendering="crispEdges" aria-hidden="true">
      <g fill="currentColor">
        <rect x="6" y="1" width="4" height="2" />
        <rect x="6" y="13" width="4" height="2" />
        <rect x="1" y="6" width="2" height="4" />
        <rect x="13" y="6" width="2" height="4" />
        <rect x="3" y="3" width="2" height="2" />
        <rect x="11" y="3" width="2" height="2" />
        <rect x="3" y="11" width="2" height="2" />
        <rect x="11" y="11" width="2" height="2" />
        <rect x="7" y="8" width="2" height="5" />
        <rect x="6" y="7" width="4" height="2" />
      </g>
      <rect x="7" y="3" width="2" height="5" fill="var(--accent)" />
    </svg>
  )
}
{
  name === 'puertas' && (
    <svg viewBox="0 0 16 16" shape-rendering="crispEdges" aria-hidden="true">
      <g fill="currentColor">
        <rect x="1" y="4" width="4" height="10" />
        <rect x="6" y="3" width="4" height="11" />
        <rect x="11" y="4" width="4" height="10" />
      </g>
      <g fill="var(--accent)">
        <rect x="3" y="9" width="1" height="1" />
        <rect x="8" y="8" width="1" height="1" />
        <rect x="13" y="9" width="1" height="1" />
      </g>
    </svg>
  )
}
{
  name === 'pergamino' && (
    <svg viewBox="0 0 16 16" shape-rendering="crispEdges" aria-hidden="true">
      <g fill="currentColor">
        <rect x="3" y="2" width="10" height="2" />
        <rect x="3" y="12" width="10" height="2" />
        <rect x="3" y="2" width="2" height="12" />
        <rect x="11" y="2" width="2" height="12" />
      </g>
      <g fill="var(--accent)">
        <rect x="6" y="6" width="5" height="1" />
        <rect x="6" y="8" width="5" height="1" />
        <rect x="6" y="10" width="3" height="1" />
      </g>
    </svg>
  )
}
{
  name === 'salida' && (
    <svg viewBox="0 0 16 16" shape-rendering="crispEdges" aria-hidden="true">
      <g fill="currentColor">
        <rect x="3" y="1" width="2" height="14" />
        <rect x="3" y="1" width="8" height="2" />
        <rect x="9" y="1" width="2" height="14" />
      </g>
      <g fill="var(--accent)">
        <rect x="5" y="3" width="4" height="12" />
        <rect x="11" y="5" width="3" height="1" />
        <rect x="11" y="8" width="4" height="1" />
        <rect x="11" y="11" width="3" height="1" />
      </g>
    </svg>
  )
}

<style>
  svg {
    display: block;
  }
</style>
