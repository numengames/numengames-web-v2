---
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import PixelArt from './PixelArt.astro';
import { useTranslations, type Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
  entry: CollectionEntry<'story'>;
  slug: string;
  actLabel: string;
  /** id extra para las anclas de acto (#acto-2, #acto-3). */
  actAnchor?: string;
}
const { lang, entry, slug, actLabel, actAnchor } = Astro.props;
const t = useTranslations(lang);
const { Content } = await render(entry);
const headingId = `${slug}-title`;
---

<section
  id={actAnchor ?? slug}
  class="phase panel"
  data-phase={`fase-${entry.data.phase}`}
  data-act={String(entry.data.act)}
  data-act-label={actLabel}
  aria-labelledby={headingId}
>
  <div class="container-n">
    {actAnchor && <span id={slug} />}
    <p class="eyebrow" data-reveal>{actLabel}</p>
    <h2 class="phase-title" id={headingId} data-reveal>{entry.data.title}</h2>
    {
      entry.data.subtitle && (
        <p class="phase-sub" data-reveal>
          {entry.data.subtitle}
        </p>
      )
    }

    <div class="dialog px" data-reveal>
      <p class="speaker">
        <span class="speaker-portrait"><PixelArt name="senet" /></span>
        <span>{t('speaker.senet')}</span>
      </p>
      <type-writer class="prose-n" data-skip-label={t('tw.skip')}>
        <Content />
      </type-writer>
    </div>

    <slot />
  </div>
</section>
