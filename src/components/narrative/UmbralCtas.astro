---
import { localePath, useTranslations, type Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<div class="ctas" data-reveal>
  <a class="btn btn-solid" href={localePath(lang, 'contacto')}>
    <span class="verb">{t('verb.usar')}</span>
    {t('umbral.cta.evento')}
  </a>
  <a class="btn" href={localePath(lang, 'contacto', '#oraculo')}>
    <span class="verb">{t('verb.hablar')}</span>
    {t('umbral.cta.oraculo')}
  </a>
  <a class="btn btn-quiet" href={localePath(lang, 'experiencias')}>
    <span class="verb">{t('verb.mirar')}</span>
    {t('umbral.cta.explorar')}
  </a>
</div>

<style>
  .ctas {
    margin-top: var(--space-600);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-400);
    align-items: center;
  }
</style>
