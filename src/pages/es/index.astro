---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import HeroFiltro from '../../components/narrative/HeroFiltro.astro';
import PhaseSection from '../../components/narrative/PhaseSection.astro';
import CaminoCard from '../../components/narrative/CaminoCard.astro';
import PortalCard from '../../components/narrative/PortalCard.astro';
import UmbralCtas from '../../components/narrative/UmbralCtas.astro';
import JourneyMeter from '../../components/narrative/JourneyMeter.astro';
import { useTranslations, type Lang } from '../../i18n/ui';

const lang: Lang = 'es';
const t = useTranslations(lang);

const entries = (await getCollection('story', ({ data }) => data.lang === lang)).sort(
  (a, b) => a.data.order - b.data.order,
);
const fases = entries.filter((e) => e.data.kind === 'fase');
const caminos = entries.filter((e) => e.data.kind === 'camino');
const portales = entries.filter((e) => e.data.kind === 'portal');

const slugOf = (id: string) =>
  id
    .split('/')
    .pop()!
    .replace(/^\d+[a-z]?-/, '');
const actLabel = (act: number) => t(`acts.${act}` as 'acts.1');

const seenActs = new Set<number>([1]);
const sections = fases.map((entry) => {
  let actAnchor: string | undefined;
  if (!seenActs.has(entry.data.act)) {
    seenActs.add(entry.data.act);
    actAnchor = `acto-${entry.data.act}`;
  }
  return { entry, slug: slugOf(entry.id), actAnchor, actLabel: actLabel(entry.data.act) };
});

const enterHref = `#${sections[0]?.slug ?? 'acto-2'}`;
---

<BaseLayout {lang} pageKey="home">
  <HeroFiltro {lang} {enterHref} actLabel={actLabel(1)} />

  {
    sections.map((s) => (
      <PhaseSection entry={s.entry} slug={s.slug} actLabel={s.actLabel} actAnchor={s.actAnchor}>
        {s.entry.data.phase === 3 && (
          <div class="caminos">
            {caminos.map((c) => (
              <CaminoCard {lang} entry={c} slug={slugOf(c.id)} />
            ))}
          </div>
        )}
        {s.entry.data.phase === 4 && (
          <div class="portal-grid">
            {portales.map((p) => (
              <PortalCard {lang} entry={p} />
            ))}
          </div>
        )}
        {s.entry.data.phase === 5 && (
          <div class="manifesto-mark" aria-hidden="true">
            ✦
          </div>
        )}
        {s.entry.data.phase === 6 && <UmbralCtas {lang} />}
      </PhaseSection>
    ))
  }

  <JourneyMeter {lang} />
</BaseLayout>

<style>
  .caminos {
    margin-top: 2.6rem;
    display: grid;
    gap: 1.1rem;
  }
  .manifesto-mark {
    margin-top: 2rem;
    color: var(--accent);
    font-size: var(--text-lg);
  }
</style>
