---
import BaseLayout from '../../layouts/BaseLayout.astro';
import type { Lang } from '../../i18n/ui';

const lang: Lang = 'es';
---

<BaseLayout
  {lang}
  pageKey="contacto"
  title="Contacto"
  description="Pídenos una aventura: cuéntanos tu evento y diseñamos la estructura de juego que necesita."
>
  <header class="page-head container-n">
    <p class="eyebrow">Contacto</p>
    <h1>Pídenos una aventura</h1>
    <p class="lead">
      ¿Quieres que tu evento genere conexiones que cierren negocio? Cuéntanos qué quieres que ocurra
      y diseñamos la estructura para que ocurra.
    </p>
    <p class="lead">
      <span class="todo">[POR DEFINIR]</span> Canal de contacto definitivo (correo del equipo, formulario
      o agenda). De momento, escríbenos:
      <a href="mailto:hola@numen.games">hola@numen.games</a>
      <span class="todo">placeholder</span>
    </p>
  </header>

  <section class="page-section" id="oraculo" aria-labelledby="oraculo-title">
    <div class="container-n">
      <p class="eyebrow">Consulta</p>
      <h2 id="oraculo-title">Hablar con un Oráculo</h2>
      <p class="claim">
        Treinta minutos para alinear alcance, dinámica y encaje con tu evento. Sin compromiso y sin
        humo.
      </p>
      <p style="margin-top:1.2rem">
        <a class="btn" href="mailto:hola@numen.games?subject=Hablar%20con%20un%20Or%C3%A1culo">
          Reservar conversación
        </a>
      </p>
    </div>
  </section>
</BaseLayout>
