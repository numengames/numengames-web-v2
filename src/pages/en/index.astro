---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import HeroFiltro from '../../components/narrative/HeroFiltro.astro';
import PhaseSection from '../../components/narrative/PhaseSection.astro';
import CaminoSection from '../../components/narrative/CaminoSection.astro';
import PortalCard from '../../components/narrative/PortalCard.astro';
import UmbralCtas from '../../components/narrative/UmbralCtas.astro';
import JourneyMeter from '../../components/narrative/JourneyMeter.astro';
import PixelArt from '../../components/narrative/PixelArt.astro';
import Recap from '../../components/narrative/Recap.astro';
import { useTranslations, type Lang } from '../../i18n/ui';

const lang: Lang = 'en';
const t = useTranslations(lang);

const entries = (await getCollection('story', ({ data }) => data.lang === lang)).sort(
  (a, b) => a.data.order - b.data.order,
);
const flow = entries.filter((e) => e.data.kind !== 'portal');
const portales = entries.filter((e) => e.data.kind === 'portal');

const slugOf = (id: string) =>
  id
    .split('/')
    .pop()!
    .replace(/^\d+[a-z]?-/, '');
const actLabel = (act: number) => t(`acts.${act}` as 'acts.1');

const seenActs = new Set<number>([1]);
const sections = flow.map((entry) => {
  let actAnchor: string | undefined;
  if (entry.data.kind === 'fase' && !seenActs.has(entry.data.act)) {
    seenActs.add(entry.data.act);
    actAnchor = `acto-${entry.data.act}`;
  }
  return { entry, slug: slugOf(entry.id), actAnchor, actLabel: actLabel(entry.data.act) };
});

const firstFase = sections.find((s) => s.entry.data.kind === 'fase');
const enterHref = `#${firstFase?.slug ?? 'acto-2'}`;

/* Paneles de la panorámica: héroe + fases + caminos. */
const panelCount = 1 + sections.length;
---

<BaseLayout {lang} pageKey="home">
  <div class="journey-h" style={`--panels: ${panelCount}`}>
    <div class="journey-sticky">
      <div class="journey-track">
        <HeroFiltro {lang} {enterHref} actLabel={actLabel(1)} />

        {
          sections.map((s) =>
            s.entry.data.kind === 'camino' ? (
              <CaminoSection {lang} entry={s.entry} slug={s.slug} actLabel={s.actLabel} />
            ) : (
              <PhaseSection
                {lang}
                entry={s.entry}
                slug={s.slug}
                actLabel={s.actLabel}
                actAnchor={s.actAnchor}
              >
                {s.entry.data.phase === 4 && (
                  <div class="portal-grid">
                    {portales.map((p) => (
                      <PortalCard {lang} entry={p} />
                    ))}
                  </div>
                )}
                {s.entry.data.phase === 5 && (
                  <div class="manifesto-mark" aria-hidden="true">
                    ✦
                  </div>
                )}
                {s.entry.data.phase === 6 && (
                  <>
                    <Recap {lang} />
                    <UmbralCtas {lang} />
                  </>
                )}
              </PhaseSection>
            ),
          )
        }
      </div>
      <div class="nomada-walker" aria-hidden="true"><PixelArt name="nomada" /></div>
    </div>
  </div>

  <JourneyMeter {lang} />
</BaseLayout>

<style>
  .manifesto-mark {
    margin-top: 2rem;
    color: var(--accent);
    font-size: var(--text-lg);
  }
</style>
